# Voice-First AI Property Scout — Environment Configuration Template

# ── Frontend (Vercel) ──
# Leave empty for local dev (Vite proxies /api → localhost:8000)
# Set to Railway URL in production, e.g. https://scout-api.up.railway.app
VITE_API_BASE_URL=

# ── Gmail OAuth for Railway (HTTPS email; SMTP is blocked on Railway) ──
# Paste the full contents of token.json as one line JSON string
# GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"..."}
# Comma-separated allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Persistent SQLite (Railway volume) ──
# BOOKINGS_DB_PATH=/data/scout_bookings.db

# Gemini API Configuration (Primary LLM & STT)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.5-flash-lite
GEMINI_STT_MODEL=gemini-2.5-flash

# Smallest AI Configuration (Primary TTS Engine)
SMALLEST_API_KEY=your_smallest_ai_api_key_here
SMALLEST_TTS_MODEL=lightning
SMALLEST_VOICE_ID=emily

# Groq API Configuration (Free LPU Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Embedding Engine Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
VECTOR_STORE_PATH=./data/chroma_db

# Engine Provider Settings
LLM_ENGINE=gemini_flash_lite
STT_ENGINE=gemini_flash
TTS_ENGINE=smallest_ai

# Email (site visit confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=support@scout.ai

# n8n Automation Engine
N8N_WEBHOOK_URL=http://localhost:5678/webhook/site-visit-booked

# OpenStreetMap MCP Tool Server
OSM_MCP_SERVER_URL=http://localhost:8000/mcp
